{
  "name": "jarzon/primbase",
  "type": "project",
  "autoload": {
    "psr-4": {"PrimBase\\": "src/"}
  },
  "scripts": {
    "pre-update-cmd": "[ $COMPOSER_DEV_MODE -eq 0 ] || npm run gulpstop",
    "post-install-cmd": "PrimPack\\Command\\RootPackageVersion::save",
    "post-update-cmd": [
      "PrimPack\\Command\\RootPackageVersion::save",
      "[ $COMPOSER_DEV_MODE -eq 0 ] || npm run gulprestart"
    ],
    "post-create-project-cmd": [
      "Prim\\Console\\CreateProject::postCreateProject",
      "npm install"
    ],
    "clearCache": "rm -rf app/cache/*"
  },
  "config": {
    "bin-dir": "bin",
    "discard-changes": true,
    "optimize-autoloader": true,
    "apcu-autoloader": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "require": {
    "php": ">=8.4.0",
    "ext-pdo": "*",

    "jarzon/prim": "~1.0.0",
    "jarzon/primconsole": "~1.0.0",
    "jarzon/primpack": "~2.0.0",
    "symfony/yaml": "^5.0",
    "robmorgan/phinx": "~0.15.0",

    "jarzon/form": "~1.14.0",
    "jarzon/localization": "~0.4.0",
    "jarzon/querybuilder": "~1.0.0",

    "jarzon/paginationpack": "~0.5.0",
    "jarzon/userpack": "~1.0.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1.0",
    "phpstan/extension-installer": "^1.4.0",
    "phpstan/phpstan-deprecation-rules": "^2.0.0",
    "phpunit/phpunit": "~12.4.0",
    "brianium/paratest": "^7.14"
  }
}
